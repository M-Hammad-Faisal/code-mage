{
  "name": "playwright-saucedemo-example",
  "version": "1.0.0",
  "description": "Runnable example project from the Playwright tutorial at code-mage.dev, testing https://www.saucedemo.com",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --output allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "allure": "^3.17.0",
    "allure-playwright": "^3.12.2",
    "typescript": "^5.6.0"
  }
}
